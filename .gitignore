# Code - OSS core checkout. Restored by `npm run sync`, never committed.
/.core/

# Agent assets mirrored from the core are ignored through .git/info/exclude, written by
# `npm run sync` from the agentAssets paths in vshoon.lock.json.

# Display language translations. Fetched and generated by `npm run sync:i18n`, never committed.
/.i18n/
/extensions/vshoon-language-pack-*/

# Monaco distribution that VSearch's preview loads. Staged by `npm run sync:monaco`, never committed.
/extensions/vshoon-vsearch/media/monaco/

node_modules/
/out*/
# Windows package output. Produced by `npm run core -- run gulp vscode-win32-x64`.
/VSCode-win32-*/
.build/
.core/
.tmp/
*.tsbuildinfo
.DS_Store
Thumbs.db
