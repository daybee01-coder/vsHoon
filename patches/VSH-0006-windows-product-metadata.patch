 		const proc = cp.spawn('signtool.exe', ['verify', '/pa', filePath]);
-		proc.on('error', reject);
+		proc.on('error', error => {
+			// A development machine has no Windows SDK signing tools on its PATH, and this
+			// build signs nothing. Without signtool there is no signature to strip either,
+			// so packaging continues instead of failing on the last step.
+			if ((error as NodeJS.ErrnoException).code === 'ENOENT') {
+				resolve(false);
+				return;
+			}
+
+			reject(error);
+		});
 		proc.on('exit', code => resolve(code === 0));
 	});
 }
