+	 * that declared `vshoon.ui.osFileDrops` is told about the drop from here. The message goes out
+	 * on the channel the view already listens to, which keeps this seam to one file and adds no
+	 * extension host API.
+	 *
+	 * The listeners belong on the webview's own overlay container, not on the view body: the
+	 * overlay is mounted at the document root and keeps `pointer-events: auto`, so it, and not the
+	 * body underneath it, is what a drop actually lands on once the iframe stops taking events.
+	 */
+	private registerVShoonOsFileTransfer(): void {
+		const webview = this._webview.value;
+		if (!webview) {
+			return;
+		}
+
+		// Moving the view to another window rebuilds the overlay, and the old element then receives
+		// nothing, so re-attach whenever this is not the container already being listened to.
+		const container = webview.container;
+		if (this._vshoonOsFileTransferContainer === container) {
+			return;
+		}
