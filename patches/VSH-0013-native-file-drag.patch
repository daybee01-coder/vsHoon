+// #region VShoon native file drag
+
+/**
+ * Installs the implementation a declared webview view uses to hand a drag of local files to the
+ * operating system. The seam that receives the request lives in the browser layer and cannot reach
+ * a native service, so the wiring belongs here, where one is available.
+ */
+class VShoonOsFileDragContribution implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.vshoonOsFileDrag';
+
+	constructor(@INativeHostService nativeHostService: INativeHostService) {
+		registerVShoonOsFileDrag(nativeHostService);
+	}
+}
+
+registerWorkbenchContribution2(VShoonOsFileDragContribution.ID, VShoonOsFileDragContribution, WorkbenchPhase.BlockRestore);
+
+// #endregion
