+	async startFileDrag(windowId: number | undefined, paths: string[], options?: INativeHostOptions): Promise<void> {
+		const window = this.windowById(options?.targetWindowId, windowId);
+		const contents = window?.win?.webContents;
+		if (!contents || paths.length === 0) {
+			return;
+		}
+
+		// Electron rejects an empty icon, and the shell draws the drag image from the file list
+		// anyway, so a 1x1 transparent bitmap is all this needs.
