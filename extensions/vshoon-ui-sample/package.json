{
	"name": "vshoon-ui-sample",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.1.0",
	"publisher": "vshoon",
	"license": "MIT",
	"engines": {
		"vscode": "^1.137.0"
	},
	"categories": [
		"Other"
	],
	"extensionKind": [
		"ui"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"main": "./out/extension",
	"scripts": {
		"compile": "gulp compile-extension:vshoon-ui-sample",
		"watch": "gulp watch-extension:vshoon-ui-sample"
	},
	"contributes": {
		"commands": [
			{
				"command": "vshoon.uiSample.hello",
				"title": "%command.hello.title%",
				"category": "VShoon"
			}
		],
		"vshoon.ui.headerCommands": [
			{
				"version": 1,
				"id": "hello",
				"command": "vshoon.uiSample.hello",
				"title": "%command.hello.title%",
				"tooltip": "%command.hello.tooltip%",
				"order": 100
			}
		]
	}
}
