{
  "name": "vshoon-decom",
  "displayName": "Decom - JAR/Class Decompiler",
  "description": "JAR를 압축 해제하지 않고 Explorer에서 탐색하고 Class 파일을 읽기 전용으로 디컴파일하는 VShoon 내장 확장",
  "version": "0.1.0",
  "publisher": "vshoon",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
	"*",
    "onCommand:decom.resolveExplorerJar",
    "onLanguage:java"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "decom.jarExplorer",
        "displayName": "%decom.jarExplorer.displayName%",
        "selector": [
          {
            "filenamePattern": "*.jar"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "decom.classViewer",
        "displayName": "%decom.classViewer.displayName%",
        "selector": [
          {
            "filenamePattern": "*.class"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "decom.openJar",
        "title": "%decom.openJar.title%",
        "icon": "$(package)"
      },
      {
        "command": "decom.viewClassFile",
        "title": "%decom.viewClassFile.title%"
      },
      {
        "command": "decom.refreshJar",
        "title": "%decom.refreshJar.title%"
      },
      {
        "command": "vshoon.decom.clearCache",
        "title": "%vshoon.decom.clearCache.title%"
      },
      {
        "command": "vshoon.decom.cancelPrecompile",
        "title": "%vshoon.decom.cancelPrecompile.title%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "decom.openJar"
        },
        {
          "command": "decom.viewClassFile"
        },
        {
          "command": "decom.refreshJar"
        }
      ],
      "explorer/context": [
        {
          "command": "decom.openJar",
          "when": "resourceExtname == .jar",
          "group": "decom@1"
        },
        {
          "command": "decom.refreshJar",
          "when": "resourceExtname == .jar",
          "group": "decom@2"
        }
      ]
    },
    "configuration": {
      "title": "Decom",
      "properties": {
        "decom.cfr.jarPath": {
          "type": "string",
          "default": "",
          "description": "CFR 디컴파일러 jar 경로를 직접 지정합니다. 비워두면 확장이 자동으로 다운로드하여 관리합니다."
        },
        "decom.java.executable": {
          "type": "string",
          "default": "java",
          "description": "CFR 디컴파일 실행에 사용할 java 실행 파일 경로입니다."
        },
        "decom.classpath.extra": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "디컴파일 시 CFR에 추가로 전달할 classpath 목록 (더 정확한 디컴파일을 위해 외부 참조 jar/디렉터리 지정)."
        },
        "decom.cfr.options": {
          "type": "string",
          "default": "",
          "description": "CFR 실행 시 추가로 전달할 CLI 옵션 문자열 (예: \"--decodelambdas false\")."
        },
        "vshoon.decom.precompileOnExpand": {
          "type": "boolean",
          "default": true,
          "description": "%vshoon.decom.precompileOnExpand.description%"
        },
        "vshoon.decom.precompileMaxClasses": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "maximum": 250000,
          "description": "%vshoon.decom.precompileMaxClasses.description%"
        },
        "vshoon.decom.cacheMaxSizeMb": {
          "type": "number",
          "default": 512,
          "minimum": 16,
          "description": "%vshoon.decom.cacheMaxSizeMb.description%"
        },
        "vshoon.decom.decompileTimeoutSec": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "maximum": 3600,
          "description": "%vshoon.decom.decompileTimeoutSec.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:vshoon-decom",
    "watch": "gulp watch-extension:vshoon-decom"
  },
  "devDependencies": {}
}
