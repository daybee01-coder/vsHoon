{
	// The build runs inside .core, so the transpiled output and its source maps refer to the
	// overlay copy at .core/src/vs/vshoon. `sourceMapPathOverrides` maps that back to the
	// sources you actually edit, so breakpoints belong in src/vs/vshoon, never in .core.
	//
	// Keep the overrides in step with the `overlay` list in vshoon.lock.json. `npm run sync`
	// warns when an overlay entry has no override here.
	"version": "0.2.0",
	"configurations": [
		{
			// scripts/code.bat sets VSCODE_CLI=1, which the start-window policy reads as a CLI
			// launch and bypasses on purpose. Debugging the start window means launching the way
			// a desktop user does: the Electron binary directly, with no VSCODE_CLI and no target.
			//
			// This half only runs the binary - `noDebug` keeps js-debug from managing an inspector
			// of its own, which would collide with the `--inspect-brk=5875` below. The compound's
			// "VShoon: Attach to Main Process" is what attaches and releases the breakpoint.
			"type": "node",
			"request": "launch",
			"name": "VShoon: Start Window Internal",
			"noDebug": true,
			"enableContentValidation": false,
			"runtimeExecutable": "${workspaceFolder}/.core/.build/electron/vs Hoon.exe",
			"windows": {
				"runtimeExecutable": "${workspaceFolder}/.core/.build/electron/vs Hoon.exe"
			},
			"runtimeArgs": [
				"${workspaceFolder}/.core",
				"--inspect-brk=5875",
				"--no-cached-data"
			],
			"env": {
				"VSCODE_DEV": "1",
				"VSCODE_CLI": null
			},
			"outFiles": [
				"${workspaceFolder}/.core/out/**/*.js"
			],
			"sourceMapPathOverrides": {
				"${workspaceFolder}/.core/src/vs/vshoon/*": "${workspaceFolder}/src/vs/vshoon/*",
				"${workspaceFolder}/.core/extensions/vshoon-start/*": "${workspaceFolder}/extensions/vshoon-start/*",
				"${workspaceFolder}/.core/extensions/vshoon-ui-sample/*": "${workspaceFolder}/extensions/vshoon-ui-sample/*"
			},
			"presentation": {
				"hidden": true
			}
		},
		{
			"type": "node",
			"request": "launch",
			"name": "VShoon: Main Process Internal",
			"noDebug": true,
			"enableContentValidation": false,
			"runtimeExecutable": "${workspaceFolder}/.core/scripts/code.sh",
			"windows": {
				"runtimeExecutable": "${workspaceFolder}/.core/scripts/code.bat"
			},
			"runtimeArgs": [
				"--inspect-brk=5875",
				"--no-cached-data"
			],
			"outFiles": [
				"${workspaceFolder}/.core/out/**/*.js"
			],
			"sourceMapPathOverrides": {
				"${workspaceFolder}/.core/src/vs/vshoon/*": "${workspaceFolder}/src/vs/vshoon/*",
				"${workspaceFolder}/.core/extensions/vshoon-start/*": "${workspaceFolder}/extensions/vshoon-start/*",
				"${workspaceFolder}/.core/extensions/vshoon-ui-sample/*": "${workspaceFolder}/extensions/vshoon-ui-sample/*"
			},
			"presentation": {
				"hidden": true
			}
		},
		{
			"type": "node",
			"request": "attach",
			"name": "VShoon: Attach to Main Process",
			"timeout": 30000,
			"port": 5875,
			"continueOnAttach": true,
			"outFiles": [
				"${workspaceFolder}/.core/out/**/*.js"
			],
			"sourceMapPathOverrides": {
				"${workspaceFolder}/.core/src/vs/vshoon/*": "${workspaceFolder}/src/vs/vshoon/*",
				"${workspaceFolder}/.core/extensions/vshoon-start/*": "${workspaceFolder}/extensions/vshoon-start/*",
				"${workspaceFolder}/.core/extensions/vshoon-ui-sample/*": "${workspaceFolder}/extensions/vshoon-ui-sample/*"
			},
			"presentation": {
				"group": "1_vshoon",
				"order": 1
			}
		},

		// The entries below build rather than debug. They are here because only launch
		// configurations appear in the Run and Debug panel; `Terminal > Run Task` has the same
		// commands plus the ordered sequences, and `Ctrl+Shift+B` runs the development build.
		//
		// `autoAttachChildProcesses` is off on purpose: the debugger would otherwise attach to
		// every gulp and esbuild worker the build spawns and slow a nine-minute package build
		// down for no benefit. Nothing here is meant to be stepped through.
		{
			"type": "node",
			"request": "launch",
			"name": "VShoon: Build (dev)",
			"cwd": "${workspaceFolder}",
			"runtimeExecutable": "npm",
			"windows": {
				"runtimeExecutable": "npm.cmd"
			},
			"runtimeArgs": [
				"run",
				"build"
			],
			"autoAttachChildProcesses": false,
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen",
			"presentation": {
				"group": "2_build",
				"order": 1
			}
		},
		{
			"type": "node",
			"request": "launch",
			"name": "VShoon: Package (win32-x64)",
			"cwd": "${workspaceFolder}",
			"runtimeExecutable": "npm",
			"windows": {
				"runtimeExecutable": "npm.cmd"
			},
			"runtimeArgs": [
				"run",
				"core",
				"--",
				"run",
				"gulp",
				"vscode-win32-x64"
			],
			"autoAttachChildProcesses": false,
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen",
			"presentation": {
				"group": "2_build",
				"order": 2
			}
		},
		{
			"type": "node",
			"request": "launch",
			"name": "VShoon: Smoke Test (packaged)",
			"cwd": "${workspaceFolder}",
			"runtimeExecutable": "npm",
			"windows": {
				"runtimeExecutable": "npm.cmd"
			},
			"runtimeArgs": [
				"run",
				"smoke:start-window",
				"--",
				"--package",
				"VSCode-win32-x64"
			],
			"autoAttachChildProcesses": false,
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen",
			"presentation": {
				"group": "2_build",
				"order": 3
			}
		},
		{
			"type": "node",
			"request": "launch",
			"name": "VShoon: Reset Core",
			"cwd": "${workspaceFolder}",
			"runtimeExecutable": "npm",
			"windows": {
				"runtimeExecutable": "npm.cmd"
			},
			"runtimeArgs": [
				"run",
				"sync"
			],
			"autoAttachChildProcesses": false,
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen",
			"presentation": {
				"group": "2_build",
				"order": 4
			}
		}
	],

	// Debugging is split in two on purpose. `--inspect-brk=5875` halts Electron on its first line
	// and only a debugger that attaches to that port releases it, so the launch half runs with
	// `noDebug` and the attach half - `continueOnAttach` - is what resumes the process. This is the
	// same shape upstream uses in .core/.vscode/launch.json, and it does not depend on
	// `attachSimplePort`, which stopped releasing the process when the product name gained a space
	// and the binary became `vs Hoon.exe`.
	//
	// `stopAll` ties the halves together so stopping the debugger also closes the window.
	"compounds": [
		{
			"name": "VShoon: Start Window (desktop launch)",
			"stopAll": true,
			"configurations": [
				"VShoon: Start Window Internal",
				"VShoon: Attach to Main Process"
			],
			"presentation": {
				"group": "0_vshoon",
				"order": 1
			}
		},
		{
			"name": "VShoon: Main Process",
			"stopAll": true,
			"configurations": [
				"VShoon: Main Process Internal",
				"VShoon: Attach to Main Process"
			],
			"presentation": {
				"group": "0_vshoon",
				"order": 2
			}
		}
	]
}
